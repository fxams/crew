# Off by default — worker is a complete no-op unless ACP_ENABLED=1.
ACP_ENABLED=0

# Base Sepolia (Virtuals ACP testnet). Use 8453 for Base mainnet.
ACP_CHAIN_ID=84532

# Privy P-256 authorization key from Virtuals "Add Signer" (signerPrivateKey /
# authorizationPrivateKey on acp-node-v2). Not a 32-byte hex key. Never log.
# ACP_SIGNER_KEY=

# Required when ACP_ENABLED=1 — do not derive these from the signer key.
# ACP_WALLET_ID=
# ACP_WALLET_ADDRESS=
# ACP_ENTITY_ID=1
# ACP_BUILDER_CODE=

ACP_PRICE_AUTOHIRE_USD=0.25
ACP_PRICE_LAUNCH_USD=1.00
