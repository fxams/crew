# Off by default — worker is a complete no-op unless ACP_ENABLED=1.
ACP_ENABLED=0

# Base Sepolia (Virtuals ACP testnet). Use 8453 for Base mainnet.
ACP_CHAIN_ID=84532

# Signer private key from Virtuals "Add Signer". Never commit or log this.
# ACP_SIGNER_KEY=

# Wallet id from Virtuals Signers tab (required when ACP_ENABLED=1).
# ACP_WALLET_ID=

# Optional: agent smart-account address (derived from the signer if omitted).
# ACP_WALLET_ADDRESS=
# ACP_ENTITY_ID=1
# ACP_BUILDER_CODE=

ACP_PRICE_AUTOHIRE_USD=0.02
ACP_PRICE_LAUNCH_USD=0.10
