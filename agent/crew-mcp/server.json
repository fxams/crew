{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fxams/crewpay-mcp",
  "title": "CREW / CrewPay",
  "description": "Solana Pump.fun launches with KOL Autohire and CREW fee-shares (25% buyback).",
  "repository": {
    "url": "https://github.com/fxams/crew",
    "source": "github",
    "subdirectory": "agent/crew-mcp"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "crewpay-mcp",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CREW_AGENT_API_KEY",
          "description": "crew_ak_\u2026 from crew_claim_key / POST /api/agent/keys/claim, or operator key",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "CREW_LAUNCHER_KEY",
          "description": "Solana secret for launch/wire/lock/crank (env only)",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "CREW_API_URL",
          "description": "API base URL",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
