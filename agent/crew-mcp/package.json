{
  "name": "crewpay-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for CREW / CrewPay — Solana Pump.fun launches with narrative KOL Autohire and on-chain fee-shares. For crypto AI agents (Claude, GPT, Cursor, Gemini, Grok, and any MCP client).",
  "type": "module",
  "bin": {
    "crewpay-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "CREW_MCP_HTTP=1 node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "crewpay",
    "crew",
    "solana",
    "pump.fun",
    "kol",
    "crypto",
    "meme-coin",
    "agent",
    "autohire",
    "fee-share"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
