# Hosting (Render / app.crewpay.dev): VITE_BASE_PATH=/  VITE_SITE_URL=https://app.crewpay.dev
# GitHub Pages build uses VITE_BASE_PATH=/crew/ and VITE_SITE_URL=https://fxams.github.io/crew

# Required for launches: Solana wallet that receives 25% of creator fees (CREW buyback treasury).
# After $CREW lists, crank remits → this wallet accumulates SOL → buy CREW on market.
# VITE_CREW_BUYBACK_WALLET=YourTreasuryPubkeyHere

# CREW API (Render web service + Postgres) — persists coins/remits/KOLs
# VITE_CREW_API_URL=https://crewpay-api.onrender.com
# WARNING: any VITE_* value is baked into the public JS bundle — never put CREW_AGENT_API_KEY or launcher secrets here.

# Optional dedicated RPC (Helius / Alchemy / Triton). Recommended for launches.
# Default (no env): https://solana-rpc.publicnode.com
# Do NOT use api.mainnet-beta.solana.com from the browser — it returns 403 on GH Pages.
# VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_CLUSTER=mainnet-beta

# Optional CORS proxy for Pump.fun user→wallet lookups on GitHub Pages.
# Default: https://api.allorigins.win/get?url=
# VITE_PUMP_RESOLVE_PROXY=https://api.allorigins.win/get?url=

# Optional: force Pump IPFS URL (local Vite proxies /pump-ipfs automatically).
# VITE_PUMP_IPFS_URL=/pump-ipfs

# Optional Pinata JWT for metadata upload on GitHub Pages.
# If unset, CREW falls back to Irys (wallet-signed storage).
# VITE_PINATA_JWT=

# WalletConnect Cloud project id (Reown). Required for WalletConnect QR on desktop
# and mobile deep-link. If unset, the WalletConnect row is hidden; injected /
# in-app / Wallet Standard wallets still work.
# Also accepted: NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
# VITE_WALLETCONNECT_PROJECT_ID=

# Optional: include Robinhood Chain (4663) in the EVM connector list.
# VITE_ROBINHOOD_CHAIN=1

# Privy app id for embedded Solana payout wallets after X signup.
# If unset, the Privy wallet step is hidden. Also accepted on the API as PRIVY_APP_ID
# (returned by GET /api/kols/register/status). Allowlist https://crewpay.dev in the Privy Dashboard.
# VITE_PRIVY_APP_ID=

# Public Telegram Login Widget bot username (@CrewPay_Bot). Token stays on crewpay-api.
# VITE_TELEGRAM_BOT_USERNAME=CrewPay_Bot

# Public Neynar SIWN client ID for the unlisted /admin/farcaster page.
# Same value as crewpay-api NEYNAR_CLIENT_ID. Button hidden when unset.
# Never put Neynar server credentials in any VITE_* variable.
# VITE_NEYNAR_CLIENT_ID=5228faec-6153-49e8-8503-dcf0a717a075
