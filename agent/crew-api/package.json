{
  "name": "crew-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/src && cp src/schema.sql dist/src/schema.sql",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed:kols": "tsx scripts/seed-kols.ts",
    "buyback": "tsx src/buyback.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
