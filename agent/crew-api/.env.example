# Render Postgres (internal URL on Render services; external for local)
DATABASE_URL=postgresql://crewpay:PASSWORD@HOST/crewpay

# Shared secret for write APIs (PUT /api/coins, POST /api/remits)
CREW_API_KEY=generate-a-long-random-string

# CORS — comma-separated
CORS_ORIGINS=https://app.crewpay.dev,https://crewpay.dev,https://www.crewpay.dev

# Buyback cron (server-only — never commit private keys)
# CREW_BUYBACK_PRIVATE_KEY=
# CREW_BUYBACK_MINT=
# CREW_BUYBACK_MAX_SOL=0.05
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=

PORT=10000
NODE_ENV=production
