# Render Postgres (internal URL on Render services; external for local)
DATABASE_URL=postgresql://crewpay:PASSWORD@HOST/crewpay

# Board write APIs (PUT /api/coins, POST /api/remits) — may match VITE_CREW_API_KEY on the static site
CREW_API_KEY=generate-a-long-random-string

# Agent Autohire/launch — server-only, NEVER VITE_*. When set, browser CREW_API_KEY is rejected on /api/agent/*
CREW_AGENT_API_KEY=generate-a-separate-long-random-string

# Featured-ops allowlist for GET /api/coins/graduated-unfeatured + POST /api/coins/:mint/featured.
# Comma-separated sha256 hex of per-agent keys (sha256(raw_key)). Server CREW_AGENT_API_KEY still works.
# SHA256=$(printf '%s' "$CREW_AK" | sha256sum | awk '{print $1}')
# CREW_FEATURE_AGENT_KEYS_SHA256=

# CORS — comma-separated
CORS_ORIGINS=https://app.crewpay.dev,https://crewpay.dev,https://www.crewpay.dev

# 25% CREW buyback fee-share recipient (required for POST /api/agent/launch)
CREW_BUYBACK_WALLET=

# Mainnet RPC for agent launches + buyback cron
RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# Optional: shared launcher key so agents can omit x-launcher-key (avoid in multi-tenant prod)
# CREW_AGENT_LAUNCHER_KEY=

# Buyback cron (server-only — never commit private keys)
# CREW_BUYBACK_PRIVATE_KEY=
# CREW_BUYBACK_MINT=
# CREW_BUYBACK_MAX_SOL=0.05

# Bags.fm public API (optional — without this, platform=bags is disabled)
# BAGS_API_KEY=
# BAGS_API_URL=https://public-api-v2.bags.fm/api/v1

# Zora coins on Base (optional — off unless ZORA_ENABLED is set)
# ZORA_ENABLED=1
# ZORA_CHAIN=base-sepolia
# ZORA_RPC_URL=
# ZORA_TREASURY_ADDRESS=
# CREW_BUYBACK_WALLET_EVM=
# ZORA_PLATFORM_REFERRER=
# ZORA_SPLIT_FACTORY=

# Clanker v4 on Base (optional — off unless CLANKER_ENABLED is set)
# CLANKER_ENABLED=1
# CLANKER_CHAIN=base-sepolia
# CLANKER_RPC_URL=
# CLANKER_TREASURY_ADDRESS=

# vibe/vibe on Robinhood Chain (optional — off unless VIBEVIBE_ENABLED is set)
# VIBEVIBE_ENABLED=1
# VIBEVIBE_CHAIN=robinhood-testnet
# VIBEVIBE_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
# VIBEVIBE_TREASURY_ADDRESS=
# VIBEVIBE_FACTORY_ADDRESS=
# VIBEVIBE_FEE_SPLITTER_ADDRESS=

# Sui launches (testnet only — off unless SUI_ENABLED)
# SUI_ENABLED=1
# SUI_NETWORK=testnet
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# SUI_TREASURY_ADDRESS=
# SUI_LAUNCHPAD=memez
# Memez.gg / Blast.fun (default when SUI_LAUNCHPAD=memez):
# MEMEZ_CONFIG_KEY=
# CrewPay bonding-curve launchpad (when SUI_LAUNCHPAD=crewpay):
# CREWPAY_LAUNCHPAD_PACKAGE_ID=
# CREWPAY_LAUNCHPAD_CONFIG_ID=
# CREWPAY_LAUNCHPAD_MIGRATION_CONFIG_ID=
# CREWPAY_LAUNCHPAD_MEME_COIN_TYPE=

# x402 v2 pay-per-call (off unless X402_ENABLED). No secrets here — payTo is a public receiving wallet.
# Base accept is eip155:8453 USDC; payTo is env-driven (do not hardcode).
# X402_ENABLED=1
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_PAY_TO_EVM=   # default ZORA_TREASURY_ADDRESS, then CREW_BUYBACK_WALLET_EVM
# X402_SOLANA_PAY_TO=   # Solana USDC treasury (omit → Base-only accepts)
# X402_PAY_TO_SOL=      # legacy alias for X402_SOLANA_PAY_TO
# X402_PRICE_LAUNCH_USD=0.10
# X402_PRICE_AUTOHIRE_USD=0.02

# Privy embedded Solana wallets after X KOL signup. Public app id; optional app secret
# lets the API confirm the address is on that Privy user. Frontend reads VITE_PRIVY_APP_ID.
# If unset, the site hides the Privy wallet step. CrewPay never holds keys.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Optional dedicated session HMAC (else X_CLIENT_SECRET / KOL_OAUTH_STATE_SECRET).
# KOL_SESSION_SECRET=

# Telegram Login Widget + @CrewPay_Bot alerts. Server-only — never VITE_*, never log.
# Token prefix (public bot id) is returned by GET /api/kols/register/status as telegram.botId.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=CrewPay_Bot

PORT=10000
NODE_ENV=production

# Unlisted /admin/farcaster SIWN connect. Server-only — never VITE_*.
# Render names: NEYNAR_CLIENT_ID (public, same as VITE_NEYNAR_CLIENT_ID) + NEYNAR_API_KEY.
# Frontend posts signer_uuid + fid; NEYNAR_API_KEY is used only here (optional username lookup).
# NEYNAR_CLIENT_ID=5228faec-6153-49e8-8503-dcf0a717a075
# NEYNAR_API_KEY=
# CREW_ADMIN_TOKEN=
# One-time connect nonce (consumed on POST /api/admin/farcaster). Alias: issue via POST /api/admin/farcaster/nonce
# CREW_FARCASTER_NONCE=
# Optional JSON file if DATABASE_URL is unset.
# CREW_FARCASTER_STORE_PATH=data/farcaster-admin.json

# Jobs + escrow (off by default). Test/devnet only.
# JOBS_ENABLED=false
# JOBS_RAIL=sim
# Optional platform fee on task/job payouts only (bps). Default 0 — launch fee map stays 60/15/25.
# JOBS_PLATFORM_FEE_BPS=0
# JOBS_PLATFORM_FEE_WALLET=
# Require registered KOL wallet to claim tasks (default true).
# TASKS_REQUIRE_REGISTERED_KOL=true

# FLOP / tclk settlement rail (off by default; memory rail until testnet RPC is public).
# FLOP_ENABLED=false
# FLOP_RAIL=memory
# FLOP_RPC_URL=
# FLOP_CHAIN_ID=

# Virtuals ACP v2. Complete no-op unless ACP_ENABLED=1. Never commit ACP_SIGNER_KEY.
# ACP_INPROCESS=1 starts the listener inside this crewpay-api process (no extra Render worker).
# ACP_ENABLED=0
# ACP_INPROCESS=0
# ACP_CHAIN_ID=84532
# ACP_SIGNER_KEY=          # Privy P-256 authorization key (not 32-byte hex). Never log.
# ACP_WALLET_ID=            # required when ACP_ENABLED=1
# ACP_WALLET_ADDRESS=       # required when ACP_ENABLED=1 (0x…). Not derived from the signer.
# ACP_PRICE_AUTOHIRE_USD=0.25
# ACP_PRICE_LAUNCH_USD=1.00
